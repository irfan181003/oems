# Copy to .env and adjust. Never commit .env.
PORT=4000
DB_FILE=./data/oems.db
SESSION_IDLE_MINUTES=15
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGIN=http://localhost:5173
# ASSUMPTION A-7: roles allowed to use Employee self-service on their own record (comma-separated)
SELF_SERVICE_ROLES=Employee
# Demo password given to every seeded user (npm run seed)
SEED_PASSWORD=ChangeMe@123
# Login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10
